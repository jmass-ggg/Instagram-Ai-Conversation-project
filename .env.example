# ── Meta / Instagram ──────────────────────────────────────────────────────────
# Secret used to verify incoming webhook signatures (HMAC-SHA256)
META_APP_SECRET=

# Token configured in the Meta app dashboard for webhook verification
META_VERIFY_TOKEN=your_verify_token_here

# ── Internal service authentication ───────────────────────────────────────────
# Shared secret header value between FastAPI webhook service and Django app
INTERNAL_SERVICE_SECRET=change_me_to_a_long_random_secret

# ── Service URLs ───────────────────────────────────────────────────────────────
# URL the FastAPI service uses to reach the Django internal endpoint
DJANGO_INTERNAL_URL=http://django:8000

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://app:secret@db:5432/instagram_price_reply
POSTGRES_USER=app
POSTGRES_PASSWORD=secret

# ── Django ─────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace_with_a_long_random_secret_key
DEBUG=true

# ── Business configuration ─────────────────────────────────────────────────────
# Currency symbol prepended to prices in replies
CURRENCY_SYMBOL=$

# Meta Graph API version (e.g. v19.0)
GRAPH_API_VERSION=v19.0

# ── Demo / seed data ───────────────────────────────────────────────────────────
# Instagram Professional account details (used by seed_demo_data command)
INSTAGRAM_USER_ID=123456789
INSTAGRAM_USERNAME=your_instagram_handle
INSTAGRAM_ACCESS_TOKEN=your_instagram_page_access_token
INSTAGRAM_PAGE_ID=your_facebook_page_id

# Instagram media (post) ID to map to the demo product
INSTAGRAM_MEDIA_ID=17846368219941196

# Demo product values
DEMO_PRODUCT_NAME=Awesome Widget
DEMO_PRODUCT_PRICE=49.99
